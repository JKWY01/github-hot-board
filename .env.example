# GitHub Personal Access Token（强烈建议配置）
# 申请：https://github.com/settings/tokens → Generate new token (classic) → 不选任何权限，
# repo 级 public 只读即可使用（有 token 时 Search API 从 60 次/时 提升到 5000 次/时，数据缓存 5 分钟级）。
# 无 token 时站点仍可用（缓存放宽到 15 分钟，触到限流时页面显式提示）。
GITHUB_TOKEN=

# 生产域名（SEO：canonical / hreflang / sitemap / OG 用；不带末尾斜杠）
# 本地默认 http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# 可选：/api/refresh 兜底刷新接口的密钥（Vercel Cron 自动以 Bearer 头携带；手动调用用 ?secret=）
CRON_SECRET=

# 可选:数据底座(Neon Postgres 免费档)。配置后站点读路径只吃库,
# GitHub 请求仅发生在同步任务(/api/sync、npm run sync、GitHub Actions 定时)。
# 注册:https://neon.tech → New Project → 复制连接串(postgresql://…)
# 表结构与索引在首次写入时自动创建(board_head + board_snapshots)。
# 降级链:数据库 → 磁盘 .data 快照 → 现场拉取,层层兜底。
DATABASE_URL=

# 读路径接受的数据最大年龄(分钟)。默认 90:同步每 30 分钟一轮,90 分钟=容忍 3 轮失败。
# 超龄说明同步积压,读路径转磁盘/现场模式,页面数据仍正常(只是旧)。
GHB_DB_MAX_MIN=

# 明细留痕保留天数(每次同步结束时自动清理)。默认 60 天;head 表永远只留最新一拍。
SNAPSHOT_RETENTION_DAYS=

# 本地磁盘快照水合窗(分钟,默认 30):重建后优先吃 .data 不打 GitHub。
# 本机建议放宽(如 1440=24h):数据库/网络抖动时,陈而真实的数据 >> 一张错误卡。
PERSIST_HYDRATE_MAX_MIN=

# 历史拍最小间隔(分钟,默认 30):.data/history 按月 JSONL 追加的节奏。
PERSIST_HISTORY_MIN=

# 本机调试开关:读路日志([fill] db-head / hydrated-from-disk / baked-error / db-stale-rescue)
GHB_FILL_DEBUG=1

